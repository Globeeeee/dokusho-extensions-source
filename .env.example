# Copy to .env (gitignored) for local release builds. Names only here, never values.
# Load with: scripts/with-env.sh ./gradlew :src:<lang>:<name>:assembleRelease
#
# Absolute path to the extension signing keystore. Keep it outside the repo.
SIGNING_KEYSTORE=/Users/you/.dokusho/signing/dokusho-extensions.jks
ALIAS=dokusho-extensions
KEY_STORE_PASSWORD=
KEY_PASSWORD=
